# Foundry project configuration
FOUNDRY_PROJECT_ENDPOINT=https://YOUR-RESOURCE.services.ai.azure.com/api/projects/YOUR-PROJECT
FOUNDRY_MODEL_NAME=YOUR-MODEL-DEPLOYMENT
FOUNDRY_AGENT_NAME_PREFIX=Fabric-Domain-Demo

# Azure resource identifiers used only by scripts/deploy_agents.py
AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
AZURE_RESOURCE_GROUP=YOUR-RESOURCE-GROUP
FOUNDRY_ACCOUNT_NAME=YOUR-FOUNDRY-ACCOUNT
FOUNDRY_PROJECT_NAME=YOUR-FOUNDRY-PROJECT

# Tenant used for delegated end-user device-code authentication
DEMO_TENANT_ID=00000000-0000-0000-0000-000000000000

# Chat history: none, sqlite, cosmos, fabric-cosmos, or sql
CHAT_STORAGE_PROVIDER=none
CHAT_SQLITE_PATH=data/chat_history.db

# Cosmos DB settings, required only when CHAT_STORAGE_PROVIDER=cosmos
COSMOS_ENDPOINT=
# Optional. Leave blank to use DefaultAzureCredential (recommended).
COSMOS_KEY=
COSMOS_DATABASE=foundry-demo
COSMOS_CONTAINER=chat-history
# Optional local override when only Azure CLI authentication should be tried.
# AZURE_TOKEN_CREDENTIALS=AzureCliCredential

# Cosmos DB in Microsoft Fabric settings, required only when
# CHAT_STORAGE_PROVIDER=fabric-cosmos. The database and container must already
# exist in Fabric, and the container partition key must be /user_id.
FABRIC_COSMOS_ENDPOINT=
FABRIC_COSMOS_DATABASE=
FABRIC_COSMOS_CONTAINER=chat-history

# SQLAlchemy URL, required only when CHAT_STORAGE_PROVIDER=sql.
# Supports Azure SQL Database, Fabric SQL Database, and Azure SQL Managed
# Instance when the appropriate ODBC driver and SQLAlchemy dialect are present.
CHAT_SQL_URL=
